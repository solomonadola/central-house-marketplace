# MongoDB connection string (local or Atlas)
DB=mongodb://localhost:27017/central-house

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# API port (default 3000). If you change it, set API_PORT in client/.env too.
PORT=3000

# Firebase project used to verify Google sign-in tokens
FIREBASE_PROJECT_ID=centralhousemarketplace

# Set to 1 when running behind a reverse proxy (Render, Nginx, ...)
# TRUST_PROXY=1

# Set to production in deployment so the auth cookie is marked Secure
# NODE_ENV=production

# Listing addresses are geocoded with OpenStreetMap Nominatim to place them
# on a map. Set GEOCODING=off to disable, or GEOCODER_URL to use your own
# Nominatim server (the public one allows ~1 request per second).
# GEOCODING=off
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Email. With SMTP_URL unset, emails (password reset, email verification)
# are printed to the server console instead of sent.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=Central House Marketplace <no-reply@yourdomain.com>
# Base URL of the frontend, used for links in emails.
# APP_URL=http://localhost:5173

# The auth cookie is HTTPS-only when NODE_ENV=production. Set to false if
# you serve a production build over plain HTTP (e.g. Docker on your LAN).
# COOKIE_SECURE=false

# Rent reminders (due in 3 days, 1 and 7 days late) are sent by running
# `npm run rent-reminders` from a scheduler. Or set this to send them from
# the API process once a day instead.
# RENT_REMINDERS=daily
