# MongoDB connection string (local or Atlas)
DB=mongodb://localhost:27017/central-house

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# API port (default 3000). If you change it, set API_PORT in client/.env too.
PORT=3000

# Firebase project used to verify Google sign-in tokens
FIREBASE_PROJECT_ID=centralhousemarketplace

# Set to 1 when running behind a reverse proxy (Render, Nginx, ...)
# TRUST_PROXY=1

# Set to production in deployment so the auth cookie is marked Secure
# NODE_ENV=production

# Listing addresses are geocoded with OpenStreetMap Nominatim to place them
# on a map. Set GEOCODING=off to disable, or GEOCODER_URL to use your own
# Nominatim server (the public one allows ~1 request per second).
# GEOCODING=off
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
